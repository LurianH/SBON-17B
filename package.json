{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:supabase:anon": "node --env-file=.env.local scripts/smoke-supabase-anon.mjs",
    "inventory:homologation": "node --env-file=.env.local --env-file=.env.test.local scripts/inventory-homologation.mjs",
    "setup:higor-admin": "node --env-file=.env.local --env-file=.env.test.local scripts/setup-higor-admin.mjs",
    "cleanup:homologation": "node --env-file=.env.local --env-file=.env.test.local scripts/cleanup-homologation.mjs",
    "verify:production": "node --env-file=.env.local --env-file=.env.test.local scripts/verify-production-state.mjs",
    "homologate:supabase": "node --env-file=.env.local --env-file=.env.test.local scripts/load-homologation.mjs",
    "verify:homologation": "node --env-file=.env.local --env-file=.env.test.local scripts/verify-homologation.mjs",
    "test:supabase": "node --env-file=.env.local --env-file=.env.test.local scripts/validate-supabase.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260829.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "3.2.6",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
